{
  "$schema": "https://raw.githubusercontent.com/dotnet/docfx/main/schemas/docfx.schema.json",
  "metadata": [
    {
      "src": [
        { "src": "..", "files": ["GlpiNg.Plugins.Sdk.csproj"] },
        { "src": "../../GlpiNg.Modules.Abstractions", "files": ["GlpiNg.Modules.Abstractions.csproj"] }
      ],
      "dest": "api"
    }
  ],
  "build": {
    "content": [{ "files": ["index.md", "en/index.md", "toc.yml", "api/**.yml", "api/index.md"] }],
    "resource": [{ "files": ["images/**"] }],
    "output": "_site",
    "template": ["default", "modern", "template"],
    "globalMetadata": {
      "_appName": "GlpiNg.Plugins.Sdk",
      "_appTitle": "GlpiNg.Plugins.Sdk",
      "_appLogoPath": "images/logo.svg",
      "_appFaviconPath": "images/logo.svg",
      "_lang": "fr",
      "_enableSearch": true
    },
    "fileMetadata": {
      "_lang": { "en/**": "en" }
    }
  }
}
